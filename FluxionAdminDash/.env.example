# ─────────────────────────────────────────────────────────────────────────────
# FluxionAdminDash — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.development.local for local overrides (gitignored).
# On Vercel: set these in Project Settings → Environment Variables.
#
# ⚠️  HTTPS is required for production. Browsers block mixed content
#    (HTTPS page → HTTP API). Set up SSL on the VM first:
#    sudo bash scripts/setup-vm-ssl.sh <your-domain> <your-email>

# Backend API base URL (no trailing slash)
# Local dev:   http://localhost:5226/api
# Production:  https://fluxion-backend.eastasia.cloudapp.azure.com/api
VITE_API_URL=http://localhost:5226/api
