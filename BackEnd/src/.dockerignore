# .dockerignore - Exclude files and directories from Docker build context

# Git
.git
.gitignore
.gitattributes
README.md
docs/

# Development files
.vscode/
.vs/
.idea/

# Build artifacts
**/bin/
**/obj/
**/out/
**/target/
**/dist/
**/build/

# Node.js (for frontend)
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.npm
**/.yarn
package-lock.json
yarn.lock

# Test results
**/TestResults/
**/.nyc_output
**/coverage/
**/*.trx
**/*.xml

# Logs
**/logs/
**/*.log

# Environment files
**/.env
**/.env.local
**/.env.*.local
**/appsettings.Development.json
**/appsettings.Local.json

# IDE files
**/*.user
**/*.suo
**/*.sln.docstates
**/*.userprefs

# OS files
.DS_Store
Thumbs.db
*.tmp
*.temp

# Docker files themselves (prevent recursive copying)
**/Dockerfile*
**/docker-compose*
**/.dockerignore

# Frontend specific (if copying entire project)
FrontEnd/

# Documentation
**/*.md
!**/README.md

# Temporary files
**/*~
**/*.bak
**/*.swp
**/*.swo